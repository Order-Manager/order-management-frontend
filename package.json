{
  "name": "orders-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-orders 'vitest run tests'",
    "dev:emulator": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-orders",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue-toastification": "^2.0.0-rc.5",
    "vuefire": "^3.1.22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-vue": "^5.0.3",
    "vite": "^5.1.0",
    "vitest": "^3.2.4"
  }
}
