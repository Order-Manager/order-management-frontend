rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /suppliers/{supplier} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    match /inventory_categories/{category} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    match /inventory_items/{item} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /orders/{order} {
    	allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow write: if (
        request.auth != null && resource.data.requestedById == request.auth.uid) || (
        request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );

      // Limit write of requiresReviewPI to admins
      match /requiresReviewPI {
        allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      }
      
      match /status {
        allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      }
    }
    
    match /tags/{tag} {
    	allow read: if request.auth != null;
      allow write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow read, write: if request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

  }
}
