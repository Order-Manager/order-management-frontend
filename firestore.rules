rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified @devinci.fr or @edu.devinci.fr address
    function isDevinci() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('[^@]+@(edu[.])?devinci[.]fr');
    }

    function isAdmin() {
      return isDevinci() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The referent a student names on an order: an admin flagged isReferent
    function isReferent(data) {
      let path = /databases/$(database)/documents/admins/$(data.referentId);
      return data.referentId is string
        && exists(path)
        && get(path).data.get('isReferent', false) == true
        && get(path).data.email == data.referent;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOwner() {
      return resource.data.requestedById == request.auth.uid
        && resource.data.requestedBy == request.auth.token.email;
    }

    // Draft -> pending review
    function isPublish() {
      return changedKeys().hasOnly(['status'])
        && resource.data.status == 'draft'
        && request.resource.data.status == 'pendingIR';
    }

    function isCancel() {
      return changedKeys().hasOnly(['status', 'cancelledBy'])
        && resource.data.status in ['draft', 'pendingIR', 'changesRequested']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == request.auth.token.email;
    }

    // Owners can edit items while the order waits for review, or when the referent asked for changes
    function isItemsEdit() {
      return changedKeys().hasOnly(['items', 'lastItemsUpdatedBy', 'ignoreItemsModification'])
        && resource.data.status in ['pendingIR', 'changesRequested']
        && request.resource.data.items is list
        && request.resource.data.lastItemsUpdatedBy == request.auth.token.email;
    }

    // Changes made: back to review, with a reply saying what changed (the function adds it to the history)
    function isSendBack() {
      return changedKeys().hasOnly(['status', 'sentBackMessage', 'sentBackAt'])
        && resource.data.status == 'changesRequested'
        && request.resource.data.status == 'pendingIR'
        && request.resource.data.sentBackMessage is string
        && request.resource.data.sentBackMessage.trim().size() > 0
        && request.resource.data.sentBackMessage.size() <= 1000
        && request.resource.data.sentBackAt == request.time;
    }

    // Exactly one comment appended, signed by the current user, history untouched
    function isComment() {
      let before = resource.data.updates;
      let after = request.resource.data.updates;
      let added = after[before.size()];
      return changedKeys().hasOnly(['updates'])
        && after.size() == before.size() + 1
        // An empty slice raises an error in rules, so skip the prefix check on an empty history
        && (before.size() == 0 || after[0:before.size()] == before)
        && added.keys().hasOnly(['type', 'date', 'author', 'message'])
        && added.type == 'comment'
        && added.author == request.auth.token.email
        && added.date is timestamp
        && added.message is string
        && added.message.size() > 0
        && added.message.size() <= 1000;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (isDevinci() && resource.data.requestedBy == request.auth.token.email);

      allow create: if isDevinci()
        && request.resource.data.requestedBy == request.auth.token.email
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.status in ['draft', 'pendingIR']
        && request.resource.data.updates == []
        // An order created archived would never reach the reviewers
        && request.resource.data.get('archived', false) == false
        // Invoices are attached by staff through the orders-files service
        && !('invoices' in request.resource.data)
        && isReferent(request.resource.data);

      allow update: if (isAdmin()
          && !changedKeys().hasAny(['requestedBy', 'requestedById', 'creationDate']))
        || (isDevinci() && isOwner()
          && (isPublish() || isCancel() || isItemsEdit() || isSendBack() || isComment()));

      allow delete: if false;
    }

    match /suppliers/{supplier} {
      allow read: if isDevinci();
      allow write: if isAdmin();
    }

    match /tags/{tag} {
      allow read: if isDevinci();
      allow write: if isAdmin();
    }

    // Parts the lab usually buys, which students can add to an order in one click
    match /catalog/{part} {
      allow read: if isDevinci();
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      // Everyone signed in can list the referents (to pick one when ordering); the rest stays private
      allow read: if isDevinci() && (request.auth.uid == userId || isAdmin() || resource.data.get('isReferent', false) == true);
      allow write: if isAdmin();
    }

    // Everything else (mail, ...) is only reachable from Cloud Functions
  }
}
